# PriceIQ Environment Configuration
# =================================
# Set USE_POSTGRES=1 to route all database operations to PostgreSQL schema 'price_iq'.
# If unset, PriceIQ defaults to local SQLite for isolated offline testing.

USE_POSTGRES=1

# PostgreSQL Direct Connection
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=scrapingdb
PGUSER=scraper_user
PGPASSWORD=your_postgres_password_here
PGSCHEMA=price_iq

# Alternatively, specify a complete connection URI:
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/scrapingdb?options=-csearch_path%3Dprice_iq,public
